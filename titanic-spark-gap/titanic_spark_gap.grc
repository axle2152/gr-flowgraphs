        gui_hint: 'tab@0: 3, 1, 1, 1'
        label: Monitor RX bandwidth (Hz)
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '3000'
        step: '1000'
        stop: '35000'
        value: '20000'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 584
        - 100
        rotation: 0
        state: enabled
-   name: samp_rate
    id: variable
    parameters:
        comment: 'HackRF Soapy sink: whole-MHz rates only. The replica fills this
            whole width'
        value: '2000000'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 200
        - 12
        rotation: 0
        state: enabled
-   name: spark_rate
    id: variable_qtgui_range
    parameters:
        comment: 'Titanic: 840 (420 Hz alternator, sparks at both peaks)'
        gui_hint: 'tab@0: 1, 0, 1, 1'
        label: Spark rate (/s)
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '300'
        step: '10'
        stop: '1200'
        value: '840'
