options:
  parameters:
    author: Mike
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Multipath / picket-fencing simulator feeding an FM stereo receiver
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fm_multipath_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: FM Multipath / Picket-Fence Simulator
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: aud_rate
  id: variable
  parameters:
    comment: ''
    value: quad_rate//8
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 12]
    rotation: 0
    state: enabled
- name: fade_depth
  id: variable_qtgui_range
  parameters:
    comment: How deep the reflection null cuts (0=none, 1=full destructive)
    gui_hint: ''
    label: Reflection Depth
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.05'
    stop: '1.0'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 100]
    rotation: 0
    state: enabled
- name: flutter_rate
  id: variable_qtgui_range
  parameters:
    comment: Hz - how fast the nulls sweep (flutter/picket rate)
    gui_hint: ''
    label: Flutter Rate (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-40'
    step: '0.5'
    stop: '40'
    value: '6'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [248, 96.0]
    rotation: 0
    state: enabled
- name: lmr_taps
  id: variable
  parameters:
    comment: ''
    value: firdes.band_pass(1.0, quad_rate, 24000, 52000, 4000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 12]
    rotation: 0
    state: enabled
- name: lpr_delay
  id: variable_qtgui_range
  parameters:
    comment: 'Samples at quad_rate. Lines L+R up with L-R: 481 (22 kHz HPF) + 32

      (lmr_align) = 513. Retune if you change those filters.'
    gui_hint: ''
    label: LPR Delay
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '0'
    step: '1'
    stop: '2000'
    value: '513'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 96.0]
    rotation: 0
    state: enabled
- name: noise_v
  id: variable_qtgui_range
  parameters:
    comment: AWGN noise floor
    gui_hint: ''
    label: Noise Voltage
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.005'
    stop: '1'
    value: '0.02'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [752, 8.0]
    rotation: 0
    state: enabled
- name: quad_gain
  id: variable
  parameters:
    comment: ''
    value: quad_rate/(2*math.pi*75e3)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [384, 12]
    rotation: 0
    state: enabled
- name: quad_rate
  id: variable
  parameters:
    comment: ''
    value: samp_rate//5
  states:
