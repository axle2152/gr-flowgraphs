- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: block-adaptive leaky CMA equaliser\
      \ for FM broadcast.\nHardened version - cannot diverge, cannot latch its own\
      \ freeze, and reports\nwhat it is doing so a misbehaviour can be attributed.\n\
      \nSettings at 400 kHz (quad_rate):\n    ntaps=21, mu=1.0, block=64, leak=1e-7,\
      \ modulus=1.0\n    freeze_thresh=0.0   <-- start here; see note below\n    debug=200\
      \           <-- print every 200 blocks, 0 to disable\n\nDIAGNOSING A BLOWUP\n\
      \  Watch the printed |w|.\n    |w| climbs above ~2      -> the equaliser is\
      \ the problem\n    |w| stays near 1.0       -> the AGC ahead of it is the problem\n\
      \                                (analog.agc_cc with max_gain=65536 will wind\n\
      \                                 up during a deep fade and overshoot on\n \
      \                                recovery; cap max_gain at ~8)\n    err_avg\
      \ pinned high      -> freeze latch; that is why it now has\n               \
      \                 hysteresis and a reset\n\nfreeze_thresh: leave at 0.0 until\
      \ you have confirmed the equaliser is at\nfault.  The freeze exists to stop\
      \ CMA chasing an uninvertible deep null, but\nit is the more suspicious half\
      \ of the block.\n\"\"\"\n\nimport numpy as np\nfrom numpy.lib.stride_tricks\
      \ import sliding_window_view\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, ntaps=21, mu=1.0, block=64, leak=1e-7,\n           \
      \      modulus=1.0, freeze_thresh=0.0, debug=0):\n        gr.sync_block.__init__(\n\
      \            self, name=\"FM CMA Equalizer (hardened)\",\n            in_sig=[np.complex64],\
      \ out_sig=[np.complex64])\n\n        self.ntaps = int(ntaps)\n        self.mu\
      \ = float(mu)\n        self.block = int(block)\n        self.leak = float(leak)\n\
      \        self.R2 = float(modulus)\n        self.freeze_thresh = float(freeze_thresh)\n\
      \        self.debug = int(debug)\n\n        # hard limits - a passthrough equaliser\
      \ has norm 1.0\n        self.w_soft = 4.0          # rescale above this\n  \
      \      self.w_hard = 8.0          # full reset above this\n        self.err_clip\
      \ = 1.0        # same clamp GNU Radio's cma_equalizer_cc uses\n\n        self.w\
      \ = self._center_spike()\n        self.hist = np.zeros(self.ntaps - 1, dtype=np.complex128)\n\
      \        self.err_avg = 0.0\n        self.frozen = False\n        self.nblk\
      \ = 0              # <-- this is what was missing\n        self.nreset = 0\n\
      \n        self.set_output_multiple(self.block)\n\n    def _center_spike(self):\n\
      \        w = np.zeros(self.ntaps, dtype=np.complex128)\n        w[self.ntaps\
      \ // 2] = 1.0\n        return w\n\n    def work(self, input_items, output_items):\n\
      \        x = input_items[0].astype(np.complex128)\n        out = output_items[0]\n\
      \        n = len(x)\n\n        padded = np.concatenate([self.hist, x])\n   \
      \     X = sliding_window_view(padded, self.ntaps)[:, ::-1]\n\n        w = self.w\n\
      \        B = self.block\n        mu, leak, R2 = self.mu, self.leak, self.R2\n\
      \        ft = self.freeze_thresh\n        ea = self.err_avg\n\n        for i\
      \ in range(0, n, B):\n            j = min(i + B, n)\n            Xb = X[i:j]\n\
      \            yb = Xb @ w\n            out[i:j] = yb\n\n            e = np.abs(yb)\
      \ ** 2 - R2\n            ea += 0.01 * (float(np.mean(e * e)) - ea)\n\n     \
      \       # hysteresis: freeze above the threshold, release at half of it,\n \
      \           # so frozen taps producing high error cannot hold the freeze on\n\
      \            if ft > 0.0:\n                if self.frozen:\n               \
      \     if ea < 0.5 * ft:\n                        self.frozen = False\n     \
      \           elif ea > ft:\n                    self.frozen = True\n\n      \
      \      if not self.frozen:\n                e = np.clip(e, -self.err_clip, self.err_clip)\n\
      \                energy = float(np.mean(np.sum(np.abs(Xb) ** 2, axis=1)))\n\
      \                # floor the denominator: during a deep fade the block energy\n\
      \                # collapses and an unfloored 1/energy makes the step explode\n\
      \                energy = max(energy, 0.05 * self.ntaps)\n                grad\
      \ = (e * yb) @ Xb.conj() / len(yb)\n                w = (1.0 - leak) * w - (mu\
      \ / energy) * grad\n\n                nrm = np.linalg.norm(w)\n            \
      \    if not np.isfinite(nrm) or nrm > self.w_hard:\n                    w =\
      \ self._center_spike()      # back to passthrough\n                    ea =\
      \ 0.0\n                    self.frozen = False\n                    self.nreset\
      \ += 1\n                elif nrm > self.w_soft:\n                    w *= self.w_soft\
      \ / nrm\n\n            self.nblk += 1\n            if self.debug and self.nblk\
      \ % self.debug == 0:\n                print(f\"|w|={np.linalg.norm(w):7.3f}\
      \  err_avg={ea:8.5f}  \"\n                      f\"frozen={int(self.frozen)}\
      \  resets={self.nreset}\",\n                      flush=True)\n\n        self.w\
      \ = w\n        self.err_avg = ea\n        self.hist = padded[-(self.ntaps -\
      \ 1):]\n        return n\n\n    def get_taps(self):\n        return self.w.copy()"
    affinity: ''
    alias: ''
    block: '64'
    comment: ''
    debug: '200'
    freeze_thresh: '0'
    leak: 1e-7
    maxoutbuf: '0'
    minoutbuf: '0'
    modulus: '1'
    mu: '1'
    ntaps: '21'
  states:
    _io_cache: ('FM CMA Equalizer (hardened)', 'blk', [('ntaps', '21'), ('mu', '1.0'),
      ('block', '64'), ('leak', '1e-07'), ('modulus', '1.0'), ('freeze_thresh', '0.0'),
      ('debug', '0')], [('0', 'complex', 1)], [('0', 'complex', 1)], '', ['block',
      'debug', 'freeze_thresh', 'leak', 'mu', 'ntaps'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [904, 104.0]
    rotation: 0
    state: enabled
