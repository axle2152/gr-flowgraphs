            '2.0'), ('mode', '0'), ('key', '0'), ('spark_rate', '840.0'), ('orig_freq',
            '500000.0'), ('decrement', '0.2'), ('coupling', '0.1'), ('timing_jitter',
            '0.02'), ('amp_jitter', '0.05'), ('level', '0.9')], [], [('0', 'complex',
            1)], '', ['amp_jitter', 'coupling', 'decrement', 'key', 'level', 'mode',
            'orig_freq', 'repeat_gap', 'samp_rate', 'spark_rate', 'text', 'timing_jitter',
            'wpm'])
        bus_sink: false
