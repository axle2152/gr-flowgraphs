-   name: shift
    id: blocks_rotator_cc
    parameters:
        affinity: ''
        alias: ''
        comment: Moves the spark from lo_freq to tx_freq
        maxoutbuf: '0'
        minoutbuf: '0'
        phase_inc: 2 * math.pi * (tx_freq - lo_freq) / samp_rate
        tag_inc_update: 'False'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 304
        - 420
        rotation: 0
