-   name: tx_check
    id: snippet
    parameters:
        alias: ''
        code: "# Warns before transmitting where other services are, or at a gain\
            \ high enough\n# for an antenna to put this on the air. Warnings only.\n\
            import sys, time\n_warn = []\n_lo, _hi = max(0.0, self.lo_freq - self.samp_rate\
            \ / 2), self.lo_freq + self.samp_rate / 2\n_warn.append(f'Spark at {self.tx_freq\
            \ / 1e3:.0f} kHz; its skirts fill {_lo / 1e6:.3f} to {_hi / 1e6:.3f} MHz.')\n\
            if _lo < 535e3 and _hi > 190e3:\n    _warn.append('190-535 kHz: aeronautical\
            \ and maritime beacons and maritime radio.')\nif _lo < 1700e3 and _hi\
            \ > 530e3:\n    _warn.append('530-1700 kHz: AM broadcasting.')\nif _lo\
            \ < 434.79e6 and _hi > 433.05e6:\n    _warn.append('That covers 433.05-434.79\
            \ MHz: key fobs, tyre sensors, weather stations')\n    _warn.append('and\
            \ remote controls (433.92 MHz).')\nif 108e6 < _hi and _lo < 137e6:\n \
            \   _warn.append('108 to 137 MHz is aircraft navigation and voice radio.')\n\
            if _hi >= 608e6:\n    _warn.append('608 MHz and up is radio astronomy,\
            \ cellular and public-safety radio.')\nif self.hackrf_amp or self.rf_gain\
            \ > 20:\n    _warn.append(f'HackRF gain {self.rf_gain} dB' + (' with the\
            \ +14 dB amp.' if self.hackrf_amp else '.'))\n    _warn.append('With an\
            \ antenna attached, that goes out over the air.')\nprint('!' * 76 + '\\\
            nWARNING\\n' + '\\n'.join(_warn)\n      + '\\nSpark (damped-wave) emissions\
            \ are banned on the air. Closed loop only:'\n      + '\\na dummy load,\
            \ or coax with attenuators.\\n' + '!' * 76,\n      file=sys.stderr, flush=True)\n\
            if sys.stderr.isatty() and (self.hackrf_amp or self.rf_gain > 20):\n \
            \   for _n in range(5, 0, -1):\n        print(f'Starting in {_n} s (Ctrl-C\
            \ to stop)', file=sys.stderr, flush=True)\n        time.sleep(1)"
        comment: Warns before transmitting (see the README's Legal section)
        priority: '0'
        section: main_after_init
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 800
        - 12
        rotation: 0
        state: enabled
