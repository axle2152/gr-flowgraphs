    id: variable_qtgui_chooser
    parameters:
        comment: ''
        gui_hint: 'tab@0: 4, 0, 1, 1'
        label: Keying
        label0: ''
        label1: ''
        label2: ''
        label3: ''
        label4: ''
        labels: '[''Message (loops)'', ''Hand key'']'
        num_opts: '0'
        option0: '0'
        option1: '1'
        option2: '2'
        option3: '3'
        option4: '4'
        options: '[0, 1]'
        orient: Qt.QHBoxLayout
        type: int
        value: '0'
        widget: radio_buttons
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 200
        - 300
        rotation: 0
        state: enabled
