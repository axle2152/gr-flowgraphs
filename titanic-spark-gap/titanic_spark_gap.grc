        bus_structure: null
        coordinate:
        - 200
        - 100
        rotation: 0
        state: enabled
-   name: tx_freq
    id: variable
    parameters:
        comment: 'Where the spark is transmitted: 500 kHz = 600 m, as on the Titanic'
        value: 500e3
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 296
        - 12
        rotation: 0
        state: enabled
-   name: volume
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 'tab@0: 4, 1, 1, 1'
        label: Monitor volume
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '0'
        step: '0.1'
        stop: '10'
        value: '4'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 584
        - 200
        rotation: 0
        state: enabled
-   name: wpm
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 'tab@0: 1, 1, 1, 1'
