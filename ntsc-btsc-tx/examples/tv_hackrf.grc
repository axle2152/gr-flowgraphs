options:
  parameters:
    author: ''
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: NTSC-M + BTSC stereo TV transmitter on a HackRF (gr-osmosdr)
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: tv_hackrf
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: NTSC BTSC TV transmitter (HackRF)
    window_size: 1280, 1024
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: channel
  id: parameter
  parameters:
    alias: ''
    comment: Broadcast channel number
    hide: none
    label: Channel
    short_id: c
    type: intx
    value: '3'
  states:
    coordinate:
    - 200
    - 8
    rotation: 0
    state: enabled
- name: media
  id: parameter
  parameters:
    alias: ''
    comment: File, rtmp://..., srt://..., test, bars
    hide: none
    label: Input
    short_id: i
    type: str
    value: test
  states:
    coordinate:
    - 320
    - 8
    rotation: 0
    state: enabled
- name: tx_gain
  id: parameter
  parameters:
    alias: ''
    comment: HackRF TX VGA, 0-47 dB
    hide: none
    label: TX gain
    short_id: g
    type: eng_float
    value: '0'
  states:
    coordinate:
    - 440
    - 8
    rotation: 0
    state: enabled
- name: visual
  id: variable
  parameters:
    comment: Visual carrier; the HackRF is tuned right on it
    value: ntsc_btsc.visual_carrier(channel)
  states:
    coordinate:
    - 560
    - 8
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import ntsc_btsc
  states:
    coordinate:
    - 8
    - 120
    rotation: 0
    state: enabled
- name: ntsc_btsc_tv_source_0
  id: ntsc_btsc_tv_source
  parameters:
    affinity: ''
    alias: ''
    aspect: '''pad'''
    audio_gain_db: '0'
    aural_db: '-10'
    channel_offset: 1.75e6
    comment: ''
    idle: '''bars'''
    input: media
    input_args: ''
    interlaced: 'True'
    latency: '0.3'
    level: '0.9'
    listen: 'False'
    live: None
    loop_file: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    sap: ''
    sap_track: '-1'
    setup: '7.5'
    stereo: 'True'
    samp_rate: ntsc_btsc.FS
  states:
    coordinate:
    - 120
    - 200
    rotation: 0
    state: enabled
- name: osmosdr_sink_0
  id: osmosdr_sink
  parameters:
    affinity: ''
    alias: ''
    ant0: ''
    args: '"hackrf=0"'
    bb_gain0: '0'
    bw0: 12e6
    comment: ''
    corr0: '0'
    freq0: visual
    gain0: '0'
    if_gain0: tx_gain
    maxoutbuf: '0'
    minoutbuf: '0'
    nchan: '1'
    num_mboards: '1'
    sample_rate: ntsc_btsc.FS
    sync: none
    type: fc32
  states:
    coordinate:
    - 520
    - 200
    rotation: 0
    state: enabled
- name: tx_check
  id: snippet
  parameters:
    alias: ''
    code: |-
      # Warns before transmitting on a channel that is also used by safety services
      # (608 MHz and up, the cable plans' aircraft and public-safety bands), or with the
      # HackRF's gain high enough that an antenna would put it on the air. Warnings only.
      from ntsc_btsc import safety
      safety.warn(safety.report(self.visual, self.tx_gain, False, label=f'Channel {self.channel}'))
    comment: Warns before transmitting (see the README's legal note)
    priority: '0'
    section: main_after_init
  states:
    coordinate:
    - 640
    - 8
    rotation: 0
    state: enabled
connections:
- - ntsc_btsc_tv_source_0
  - '0'
  - osmosdr_sink_0
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.9.2
