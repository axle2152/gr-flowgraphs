options:
    parameters:
        author: fole7936
        catch_exceptions: 'True'
        category: '[GRC Hier Blocks]'
        cmake_opt: ''
        comment: ''
        copyright: ''
        description: Marconi 5 kW synchronous rotary-spark transmitter replica for
            a HackRF
        gen_cmake: 'On'
        gen_linking: dynamic
        generate_options: qt_gui
        hier_block_src_path: '.:'
        id: titanic_spark_gap
        max_nouts: '0'
        output_language: python
        placement: (0,0)
        qt_qss_theme: ''
        realtime_scheduling: ''
        run: 'True'
        run_command: '{python} -u {filename}'
        run_options: prompt
        sizing_mode: fixed
        thread_safe_setters: ''
        title: RMS Titanic Spark Transmitter (replica)
        window_size: (1000,1000)
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 8
        - 8
        rotation: 0
        state: enabled
blocks:
-   name: coupling
    id: variable_qtgui_range
    parameters:
        comment: 0 = one circuit (one hump); higher = tighter coupling, two humps
            further apart
        gui_hint: 'tab@0: 2, 1, 1, 1'
        label: Jigger coupling k
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '0'
        step: '0.01'
        stop: '0.4'
        value: '0.1'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 200
        - 200
        rotation: 0
        state: enabled
-   name: decrement
    id: variable_qtgui_range
    parameters:
        comment: Logarithmic decrement. 1912 US limit 0.2; plain sparks were often
            far higher
        gui_hint: 'tab@0: 2, 0, 1, 1'
        label: Decrement (per RF cycle)
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '0.02'
        step: '0.01'
        stop: '1.0'
        value: '0.2'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 8
        - 200
        rotation: 0
        state: enabled
-   name: hackrf_amp
    id: variable
    parameters:
        comment: HackRF +14 dB amplifier
        value: 'False'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 392
        - 12
        rotation: 0
        state: enabled
-   name: jitter
    id: variable_qtgui_range
    parameters:
        comment: RMS, fraction of the spark period. ~0 synchronous disc (musical);
            0.3+ plain gap (rasp)
        gui_hint: 'tab@0: 3, 0, 1, 1'
        label: Spark timing jitter
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '0'
        step: '0.005'
        stop: '0.5'
        value: '0.02'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 392
        - 200
        rotation: 0
        state: enabled
-   name: key
    id: variable_qtgui_push_button
    parameters:
        comment: ''
        gui_hint: 'tab@0: 6, 0, 1, 2'
        label: Key (hold, in Hand key mode)
        pressed: '1'
        released: '0'
        type: int
        value: '0'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 392
        - 300
        rotation: 0
        state: enabled
-   name: lo_freq
    id: variable
    parameters:
        comment: HackRF tuning. Kept off tx_freq so its carrier leak is not on the
            spark
        value: 1e6
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 296
        - 76
        rotation: 0
        state: enabled
-   name: message
    id: variable_qtgui_entry
    parameters:
        comment: <SOS> sends a run-together prosign
        entry_signal: editingFinished
        gui_hint: 'tab@0: 5, 0, 1, 2'
        label: Message
        type: string
        value: CQD CQD CQD DE MGY 41.46N 50.14W
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 8
        - 300
        rotation: 0
        state: enabled
